<h1 id=3D"ApplicationStatusOperationalization-Newincident/schedulemaintenan=
ceeventcreation">New incident/schedule maintenance event creation</h1>
<p><br></p>
<div class=3D"table-wrap">
 <table class=3D"relative-table wrapped confluenceTable" style=3D"width: 98=
.5989%;">
  <colgroup>
   <col style=3D"width: 4.92819%;">
   <col style=3D"width: 51.5675%;">
   <col style=3D"width: 20.7841%;">
