    <td class=3D"confluenceTd"><span style=3D"color:#c9372c;">TBD</span></t=
d>
    <td class=3D"confluenceTd">
     <div class=3D"content-wrapper">
      <p><span style=3D"color:#c9372c;">TBD&nbsp;</span><a class=3D"conflue=
nce-userlink user-mention" data-username=3D"elmm001" href=3D"/display/~elmm=
001" data-linked-resource-id=3D"108957276" data-linked-resource-version=3D"=
2" data-linked-resource-type=3D"userinfo" data-base-url=3D"https://wiki.bnc=
.ca">Mahdi El Masaoudi</a>&nbsp;</p>
     </div></td>
    <td class=3D"confluenceTd">
     <div class=3D"content-wrapper">
      <p><span style=3D"color:#172b4d;">Bulk endpoint is required for suppo=
rting user attestation reports</span></p>
     </div></td>
   </tr>
  </tbody>
 </table>
