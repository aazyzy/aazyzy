<h2 id=3D"FUMDocumentManagementAPI-Databaseschema">Database schema</h2>
<div class=3D"table-wrap">
 <table class=3D"wrapped confluenceTable">
  <colgroup>
   <col>
  </colgroup>
  <tbody>
   <tr>
    <th scope=3D"col" class=3D"confluenceTh"><span style=3D"color:#172b4d;"=
>DOCUMENT</span></th>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <ul style=3D"text-align: left;">
      <li>document_id -serial4</li>
      <li>file_name - varchar(100)</li>
      <li>metadata - bytea //store the metadata tags</li>
      <li>file_content - bytea</li>
      <li>updated_date - timestamp</li>
      <li>updated_by - varchar(100) //map to idpSubject</li>
     </ul></td>
   </tr>
  </tbody>
 </table>
</div>
<p><br></p>
<h2 id=3D"FUMDocumentManagementAPI-Resources">Resources</h2>
<p><br></p>
<div class=3D"table-wrap">
 <table class=3D"wrapped relative-table confluenceTable" style=3D"width: 10=
1.534%;">
  <colgroup>
   <col style=3D"width: 2.53781%;">
   <col style=3D"width: 14.5249%;">
   <col style=3D"width: 27.43%;">
   <col style=3D"width: 13.877%;">
   <col style=3D"width: 17.0628%;">
   <col style=3D"width: 11.3393%;">
   <col style=3D"width: 13.229%;">
  </colgroup>
  <tbody>
   <tr>
    <th class=3D"confluenceTh">REF</th>
    <th class=3D"confluenceTh">Endpoint</th>
    <th class=3D"confluenceTh">Description</th>
    <th class=3D"confluenceTh">Request</th>
    <th class=3D"confluenceTh">Response</th>
    <th class=3D"confluenceTh">Access control(User)</th>
    <th class=3D"confluenceTh">Access control(system)</th>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"FUMDocumentManagementAPI-X1">X1</h4></td>
    <td class=3D"confluenceTd"><span style=3D"color:#172b4d;">POST /fum-doc=
ument-management/documents</span></td>
    <td class=3D"confluenceTd">
     <p>Upload a document to the data store</p>
     <p><a class=3D"external-link" href=3D"https://docs.aws.amazon.com/Amaz=
onS3/latest/API/RESTObjectPOST.html" rel=3D"nofollow">https://docs.aws.amaz=
on.com/AmazonS3/latest/API/RESTObjectPOST.html</a></p>
     <p>Supports the upload of a file contents along with its associated me=
tadata in multi-part form data format</p></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">content: multipart/form-data</pre></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">{
  document_id
}</pre></td>
    <td class=3D"confluenceTd">
     <p>Group: Wealth.CompassX.MangeFirm</p>
     <p>Role: wealth:cx-access-control:editor</p>
     <p>Permission: access-control:post-document</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-authorization:access</p></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"FUMDocumentManagementAPI-X2">X2</h4></td>
    <td class=3D"confluenceTd"><span style=3D"color:#172b4d;">GET /fum-docu=
ment-management/documents/{document-id}</span></td>
    <td class=3D"confluenceTd">Retrieve a document from the store</td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">HTTP 200<br>content: multipart/form-data<br><=
br>HTTP 404 If document does not exist</pre></td>
    <td class=3D"confluenceTd">
     <p>Group:Wealth.CompassX.MangeFirm</p>
     <p>Role: wealth:cx-access-control:editor</p>
     <p>access-control:read-document</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-authorization:access</p></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"FUMDocumentManagementAPI-X3">X3</h4></td>
    <td class=3D"confluenceTd"><span style=3D"color:#172b4d;">PUT /fum-docu=
ment-management/documents/{document-id}</span></td>
    <td class=3D"confluenceTd">Update an existing document <strong>contents=
</strong></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">content: multipart/form-data</pre></td>
    <td class=3D"confluenceTd">
     <p>404 If document-id is not found</p>
     <p>201 if successfully updated</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-access-control:editor</p>
     <p>access-control:update-document</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-authorization:access</p></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"FUMDocumentManagementAPI-X4">X4</h4></td>
    <td class=3D"confluenceTd"><span style=3D"color:#172b4d;">DELETE /fum-d=
ocument-management/documents/{document-id}</span></td>
    <td class=3D"confluenceTd">Delete an existing document</td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">
     <p>404 If document-id is not found</p>
     <p>204 if successfully deleted</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-access-control:editor</p>
     <p>access-control:delete-document</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-authorization:access</p></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"FUMDocumentManagementAPI-X5">X5</h4></td>
    <td class=3D"confluenceTd"><span style=3D"color:#172b4d;">HEAD /fum-doc=
ument-management/documents/{document-id}</span></td>
    <td class=3D"confluenceTd">
     <p>Retrieve the metadata for a document&nbsp;</p>
     <p><u><em>Raise a request with firewall/istio/akamai to open up HEAD r=
equest</em></u></p></td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">No content<br>The response headers will inclu=
de additional metadata tags<br>prefixed with "dcm-" providing information r=
egarding the document</pre></td>
    <td class=3D"confluenceTd">
     <p>Group:Wealth.CompassX.MangeFirm</p>
     <p>Role: wealth:cx-access-control:editor</p>
     <p>access-control:read-document-metadata</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-authorization:access</p></td>
   </tr>
  </tbody>
 </table>
</div>
