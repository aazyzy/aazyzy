=09"email": "",
=09"language": "",
=09"profile": {
=09=09"shortId": "",=20
&nbsp; &nbsp; =09"active": boolean,
=09=09"lastLogin": "",
=09=09"defaultModule": "",=20
=09=09"assignment": {
