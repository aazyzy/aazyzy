<body>
    <h1>New Access Model Proposal</h1>
    <div class=3D"Section1">
        <h1 id=3D"NewAccessModelProposal-Overview">Overview</h1>
<div class=3D"rwui_tabs">
 <ul class=3D"rwui_tabs_menu">
  <!-- These will be generated by the js -->
 </ul><!-- Here will the tabs go -->
 <div class=3D"rwui_tab_content" data-name=3D"NBIN (New)" data-hash=3D"tab-=
NBIN+%28New%29">
  <p><img class=3D"drawio-diagram-image" width=3D"468" style=3D"width:700px=
;max-width: 100%;" src=3D"c69cae27de3aab7dce5209586071948950c888d01d766e25b=
4e2ae5d693308b9" height=3D"207"></p>
  <h2 id=3D"NewAccessModelProposal-Accesscontrols">Access controls</h2>
  <ul>
   <li>Identity=20
    <ul>
     <li>Controls the authenticity of the user's identity</li>
    </ul></li>
   <li>API=20
    <ul>
     <li>Controls the access to the API endpoints</li>
    </ul></li>
   <li>Application=20
    <ul>
     <li>Controls the access to the application itself</li>
    </ul></li>
   <li>Feature/Resource=20
    <ul>
     <li>Controls the access to the features &amp; resources within the sai=
d application</li>
    </ul></li>
   <li>Data=20
    <ul>
     <li>Controls the access to data, stored <u>in the confines</u> of the =
application OR <u>outside</u>, i.e. in NBC's various data stores</li>
    </ul></li>
  </ul>
 </div>
 <div class=3D"rwui_tab_content" data-name=3D"NBC" data-hash=3D"tab-NBC">
  <p>Ref. <a href=3D"/spaces/GPTI/pages/1541395014/Positioning+Wealth+Manag=
ement+Application+Security+Modernization">Positioning: Wealth Management Ap=
plication Security Modernization</a></p>
 </div>
 <p><br></p>
</div>
<h1 id=3D"NewAccessModelProposal-Solution">Solution</h1>
<div class=3D"rwui_tabs">
 <ul class=3D"rwui_tabs_menu">
  <!-- These will be generated by the js -->
 </ul><!-- Here will the tabs go -->
 <div class=3D"rwui_tab_content" data-name=3D"Technologies" data-hash=3D"ta=
b-Technologies">
  <h2 id=3D"NewAccessModelProposal-Technologies">Technologies</h2>
  <ul>
   <li>CIAM=20
    <ul>
     <li>Identity access control=20
      <ul>
       <li>Okta, Azure AD, 3rd party IdP</li>
      </ul></li>
     <li>API access control=20
      <ul>
       <li>Okta (JWT)</li>
      </ul></li>
    </ul></li>
   <li>B2B IAM=20
    <ul>
     <li>Okta (JWT), AWS IAM (Policies), AWS STS (Assume-role)</li>
    </ul></li>
   <li>Data Stores=20
    <ul>
     <li>Local control system</li>
    </ul></li>
  </ul>
 </div>
 <div class=3D"rwui_tab_content" data-name=3D"Conceptual View" data-hash=3D=
"tab-Conceptual+View">
  <p><img class=3D"drawio-diagram-image" width=3D"468" style=3D"width:771px=
;max-width: 100%;" src=3D"8912541c2fd62efc11fd03c010817eb675be843404325f15f=
53708d03847900d" height=3D"625"></p>
 </div>
 <div class=3D"rwui_tab_content" data-name=3D"Logical View" data-hash=3D"ta=
b-Logical+View">
  <img class=3D"drawio-diagram-image" width=3D"468" style=3D"width:851px;ma=
x-width: 100%;" src=3D"d0249ececb3ff3d65afe271232be47176151e15c5fc229a584e2=
690f824eea76" height=3D"284">
 </div>
 <div class=3D"rwui_tab_content" data-name=3D"Data Model" data-hash=3D"tab-=
Data+Model">
  <p><img class=3D"drawio-diagram-image" width=3D"468" style=3D"width:817px=
;max-width: 100%;" src=3D"705ce6c4eb3016a5160054369840d4ae7dfd712473baf6b2e=
a97b69ed7b0346f" height=3D"443"></p>
 </div>
</div>
