      <li data-uuid=3D"b605d9d1-f72b-4922-ba3a-1c0d4aa79cf2">Data context p=
assing</li>
      <li data-uuid=3D"3cf932ad-a220-43af-bfce-dbab74ae9b24">User state man=
agement</li>
      <li data-uuid=3D"7555f875-f63c-4adb-a174-7ddd70078dbe">Register platf=
orm actions</li>
     </ul>
    </td>
