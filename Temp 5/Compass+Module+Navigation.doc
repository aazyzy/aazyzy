=09=09=09  type: 'Module'                            =09=09=09=09// Module,=
 Separator
              label: 'formApplications',
              icon: '',=09=09=09=09=09=09=09=09=09=09=09=09=09// icon enum =
for icon component
              external: true,=09=09=09=09=09=09=09=09=09=09=09// node opens=
 external link in new window or triggers SSO function
              disabled: true,=09=09=09=09=09=09=09=09=09=09=09// if node sh=
ould not be selectable
              url: 'https://nbinpprod.io.broadridge.com/index.html', =09// =
destination link or function
=09=09=09  childType: Alternatives=09=09=09=09=09=09=09=09=09// Options: [A=
lternatives, Menu] Alternatives is the default and the current behaviour, M=
enu turns off hiding the single child and making the parent operate as the =
child with the parent label
              children: []=09=09=09=09=09=09=09=09=09=09=09=09// Array of c=
hild nodes
            },</pre>
 </div>
</div>
