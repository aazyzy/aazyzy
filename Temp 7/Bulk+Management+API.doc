<h2 id=3D"BulkManagementAPI-Resources">Resources</h2>
<p><br></p>
<div class=3D"table-wrap">
 <table class=3D"relative-table wrapped confluenceTable" style=3D"width: 98=
.2466%;">
  <colgroup>
   <col style=3D"width: 4.34289%;">
   <col style=3D"width: 17.3037%;">
   <col style=3D"width: 20.1537%;">
   <col style=3D"width: 22.0538%;">
   <col style=3D"width: 19.2037%;">
   <col style=3D"width: 7.87149%;">
   <col style=3D"width: 9.02508%;">
  </colgroup>
  <tbody>
   <tr>
    <th class=3D"confluenceTh">REF</th>
    <th class=3D"confluenceTh">Endpoint</th>
    <th class=3D"confluenceTh">Description</th>
    <th class=3D"confluenceTh">Request</th>
    <th class=3D"confluenceTh">Response</th>
    <th class=3D"confluenceTh">Access control(User)</th>
    <th class=3D"confluenceTh">Access control(system)</th>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"BulkManagementAPI-BMA1">BMA1</h4></td>
    <td class=3D"confluenceTd">
     <p><span style=3D"color:#172b4d;">GET /bulk-management-api/templates/{=
name}/file</span></p>
     <p><span style=3D"color:#172b4d;">name<span style=3D"color:#172b4d;"><=
br>
         is one of TEMPLATE_NAME in BULK_UPLOAD_TEMPLATE table</span></span=
></p></td>
    <td class=3D"confluenceTd">
     <p>Download template endpoint</p>
     <p>Returns a template file<br><br></p>
     <ol style=3D"text-align: left;">
      <li>Find record in "IAM_V2"."BULK_UPLOAD_TEMPLATE" where "TEMPLATE_NA=
ME" =3D {name}. Return 404 error if not found.</li>
      <li>Read "CONFIG_JSON" column</li>
      <li>Use "fileFormat" and "headerNames"<br>
        &nbsp;to generate and send file back</li>
      <li>Filename in content disposition: {name} + "." + fileFormat&nbsp;<=
/li>
     </ol></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">Content-Type:<code class=3D"hljs language-bas=
h">application/json</code></pre></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">Content-Type: text/csv/json<br><br>{name} + "=
." + fileFormat<br><br>404 If name is not found<br><br><br></pre></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-user-conf:editor</p>
     <p>access-control:post-bulk-upload</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-user-conf:access</p></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"BulkManagementAPI-BMA2">BMA2</h4></td>
    <td class=3D"confluenceTd">
     <p><span style=3D"color:#172b4d;">POST /bulk-management-api/files/{tem=
plate-name}?firmId=3Dbla</span></p>
     <p><span style=3D"color:#172b4d;">template-name<span style=3D"color:#1=
72b4d;"><br>
         is one of TEMPLATE_NAME in BULK_UPLOAD_TEMPLATE table<br><br>
         firmId is firm the file uploaded for</span></span></p></td>
    <td class=3D"confluenceTd">
     <p>Uploads File for bulk management</p>
     <p>template-name: <span style=3D"color:#172b4d;">USER-UPDATE-NBIN</spa=
n></p></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">Content-Type: multipart/form-data<br><br>file=
</pre></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">Content-Type: text/plain<br><br>(generated ba=
tch-id)</pre></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-user-conf:editor</p>
     <p>access-control:post-bulk-upload</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-user-conf:access</p></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"BulkManagementAPI-BMA3">BMA3</h4></td>
    <td class=3D"confluenceTd">
     <p><span style=3D"color:#172b4d;">POST /bulk-management-api/batches/se=
arch</span></p></td>
    <td class=3D"confluenceTd">
     <p>Returns a list of records from BULK_UPLOAD table by <br>
       batch type and a list of template names</p>
     <p>if list of template names is not provided - return all</p></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">Content-Type:<code class=3D"hljs language-bas=
h">application/json<br><br>{<br>&nbsp; &nbsp; "batch-type" : "UPLOAD",<br>&=
nbsp; &nbsp; "template-names" : [<br>&nbsp; &nbsp; &nbsp; &nbsp; "USER-UPDA=
TE-NBIN"<br>&nbsp; &nbsp; ]<br>}<br></code></pre></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">Content-Type: <code class=3D"hljs language-ba=
sh">application/json<br><br></code></pre></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-user-conf:editor</p>
     <p>access-control:post-bulk-upload</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-user-conf:access</p></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"BulkManagementAPI-BMA4">BMA4</h4></td>
    <td class=3D"confluenceTd">
     <p><span style=3D"color:#172b4d;">GET /bulk-management-api/batches/{ba=
tch-id}/status?details=3Dfalse</span></p>
     <p><br></p></td>
    <td class=3D"confluenceTd">
     <p>Return batch status</p>
     <p><br>
       Returns a record from BULK_UPLOAD table by batch id</p>
     <p><br></p>
     <p>If details=3Dtrue add details from BULK_UPLOAD_DETAIL</p></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">Content-Type:<code class=3D"hljs language-bas=
h">application/json<br><br><br></code></pre></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">Content-Type: <code class=3D"hljs language-ba=
sh">application/json</code></pre></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-user-conf:editor</p>
     <p>access-control:post-bulk-upload</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-user-conf:access</p></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"BulkManagementAPI-BMA5">BMA5</h4></td>
    <td class=3D"confluenceTd">
     <p><span style=3D"color:#172b4d;">GET /bulk-management-api/batches/{ba=
tch-id}/file</span></p>
     <p><br></p></td>
    <td class=3D"confluenceTd">
     <p>Returns an original file uploaded by user</p>
     <p>Returns a file from AUDIT table by AUDIT_ID BULK_UPLOAD table</p></=
td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">Content-Type:<code class=3D"hljs language-bas=
h">application/json<br><br><br></code></pre></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">404 If batch-id is not found<br><br>200 Conte=
nt-Type: text/csv/json<br>(content of the original file)</pre></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-user-conf:editor</p>
     <p>access-control:post-bulk-upload</p></td>
    <td class=3D"confluenceTd">
     <p>wealth:cx-user-conf:access</p></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd">
     <h4 id=3D"BulkManagementAPI-BMA6">BMA6</h4></td>
    <td class=3D"confluenceTd">
     <p><span style=3D"color:#172b4d;">GET /bulk-management-api/batches/{ba=
tch-id}/results</span></p>
     <p><br></p></td>
    <td class=3D"confluenceTd">
     <p>Returns a status report - result</p>
     <p>Returns a file with the details from AUDIT table by GENERATED_AUDIT=
_ID from BULK_UPLOAD table</p></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">Content-Type:<code class=3D"hljs language-bas=
h">application/json<br><br><br></code></pre></td>
    <td class=3D"confluenceTd">
     <pre class=3D"code-java">404 If batch-id is not found<br><br>200 Conte=
