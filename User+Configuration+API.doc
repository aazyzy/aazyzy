fluence-embedded-image confluence-external-resource" draggable=3D"false" al=
t=3D"(tick)" src=3D"13a37f088e2ac540f19378df1c3e59610a00e753e915ed001105dd5=
327eabdee" data-image-src=3D"https://wiki.bnc.ca/s/4w5oca/8804/1gnlhi9/_/im=
ages/icons/emoticons/check.svg"></span></p>
     </div></td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">Assign</td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">PUT</td>
    <td class=3D"confluenceTd">/users/{idp-sub}/assignments/rr-range</td>
    <td class=3D"confluenceTd">
     <div class=3D"content-wrapper">
      <p><br></p>
      <div class=3D"code panel pdl" style=3D"border-width: 1px;">
       <div class=3D"codeContent panelContent pdl">
        <pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=
=3D"brush: java; gutter: false">{
  "rr-ranges": [
 &nbsp; &nbsp;{
      "from-rr-code": "", "to-rr-code": ""}
  ]
}</pre>
       </div>
      </div>
     </div></td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">
     <p><br></p>
     <ul style=3D"text-align: left;">
      <li>Ensure user state !=3D decommissioned</li>
     </ul></td>
    <td style=3D"text-align: center;" class=3D"confluenceTd">access-control=
:edit_user</td>
    <td class=3D"confluenceTd"><br></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">
     <h4 id=3D"UserConfigurationAPI-UF2">UF2</h4></td>
    <td class=3D"confluenceTd">
     <div class=3D"content-wrapper">
      <p><span class=3D"confluence-embedded-file-wrapper"><img class=3D"con=
fluence-embedded-image confluence-external-resource" draggable=3D"false" al=
t=3D"(tick)" src=3D"13a37f088e2ac540f19378df1c3e59610a00e753e915ed001105dd5=
327eabdee" data-image-src=3D"https://wiki.bnc.ca/s/4w5oca/8804/1gnlhi9/_/im=
ages/icons/emoticons/check.svg"></span></p>
      <p>:warning:</p>
      <p>user-group, resource, capability</p>
     </div></td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">Assign</td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">PUT</td>
    <td class=3D"confluenceTd">
     <p>/users/{idp-sub}/assignments/feature-package</p>
     <p>/users/{idp-sub}/assignments/firm</p>
     <p><span style=3D"color:#1f845a;">/users/{idp-sub}/assignments/user-gr=
oup</span></p>
     <p><span style=3D"color:#1f845a;">/users/{idp-sub}/assignments/resourc=
e</span></p>
     <p><span style=3D"color:#1f845a;">/users/{idp-sub}/assignments/capabil=
ity</span></p></td>
    <td class=3D"confluenceTd">
     <div class=3D"content-wrapper">
      <p><br></p>
      <div class=3D"code panel pdl" style=3D"border-width: 1px;">
       <div class=3D"codeContent panelContent pdl">
        <pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=
=3D"brush: java; gutter: false">{
  "assignee-id": ""
}</pre>
       </div>
      </div>
     </div></td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">
     <ul style=3D"list-style-type: square;">
      <li>feature package update triggers user resource (see UF7) and user-=
group assignment refresh&nbsp;</li>
      <li>Ensure user state !=3D decommissioned</li>
     </ul></td>
    <td style=3D"text-align: center;" class=3D"confluenceTd">access-control=
:edit_user</td>
    <td class=3D"confluenceTd"><br></td>
   </tr>
