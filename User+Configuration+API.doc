    <td class=3D"confluenceTd"><span style=3D"color:#172b4d;"><span style=
=3D"color:#172b4d;" title=3D"">/users/archive</span></span></td>
    <td class=3D"confluenceTd">
     <div class=3D"content-wrapper">
      <p><br></p>
     </div></td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd"><br></td>
    <td style=3D"text-align: center;" class=3D"confluenceTd"><span style=3D=
"color:#172b4d;"><span style=3D"color:#172b4d;">access-control:manage_user<=
/span></span></td>
    <td class=3D"confluenceTd"><br></td>
   </tr>
   <tr>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">
     <h4 id=3D"UserConfigurationAPI-U10">U10</h4></td>
    <td style=3D"text-align: left;" class=3D"confluenceTd"><br></td>
    <td style=3D"text-align: left;" class=3D"confluenceTd"><br></td>
    <td style=3D"text-align: left;" class=3D"confluenceTd">Get a list of us=
ers</td>
    <td class=3D"confluenceTd"><br></td>
    <td class=3D"confluenceTd">POST</td>
    <td class=3D"confluenceTd"><span style=3D"color:#172b4d;"><span style=
=3D"color:#172b4d;" title=3D"">/users/list</span></span></td>
    <td class=3D"confluenceTd">
     <div class=3D"content-wrapper">
      <p><span style=3D"background-color: rgb(240,240,240);">Take an input =
of a list of idpSubjects</span></p>
      <div class=3D"code panel pdl" style=3D"border-width: 1px;">
       <div class=3D"codeHeader panelHeader pdl hide-border-bottom" style=
=3D"border-bottom-width: 1px;">
        <b class=3D"code-title">request body</b><span class=3D"collapse-sou=
rce expand-control" style=3D"display:none;"><span class=3D"expand-control-i=
con icon">&nbsp;</span><span class=3D"expand-control-text">Expand source</s=
pan></span><span class=3D"collapse-spinner-wrapper"></span>
       </div>
       <div class=3D"codeContent panelContent pdl hide-toolbar">
        <pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=
=3D"brush: java; gutter: false; collapse: true">[
  "1234",
  "EMP001"
]
</pre>
       </div>
      </div>
      <p><span style=3D"background-color: rgb(240,240,240);">&nbsp;</span><=
/p>
     </div></td>
    <td class=3D"confluenceTd">
     <div class=3D"content-wrapper">
      <p>HTTP 200 with a list of all matching user profiles that match the =
input request list</p>
      <p><span style=3D"color:#c9372c;">The resource user list should be re=
stricted to the user's current firm and any child firms only.&nbsp;</span><=
/p>
      <p><span style=3D"color:#c9372c;">Additionally, only users who have a=
ccess to the firm_level_access resource will be able to access this endpoin=
t</span></p>
      <div class=3D"code panel pdl" style=3D"border-width: 1px;">
       <div class=3D"codeHeader panelHeader pdl hide-border-bottom" style=
=3D"border-bottom-width: 1px;">
        <b class=3D"code-title">Response</b><span class=3D"collapse-source =
expand-control" style=3D"display:none;"><span class=3D"expand-control-icon =
icon">&nbsp;</span><span class=3D"expand-control-text">Expand source</span>=
</span><span class=3D"collapse-spinner-wrapper"></span>
       </div>
       <div class=3D"codeContent panelContent pdl hide-toolbar">
        <pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=
=3D"brush: java; gutter: false; collapse: true">{
"1234": {
    "firstName": "water.test.dev",
    "lastName": "water.test.dev",
    "preferredLanguage": "EN"},
"EMP001": {...}
}</pre>
       </div>
      </div>
      <p><br></p>
     </div></td>
    <td class=3D"confluenceTd"><br></td>
    <td style=3D"text-align: center;" class=3D"confluenceTd">
     <p><strong>role: </strong>wealth:cx-user-conf:viewer</p>
     <p><strong>permission: </strong><code>access-control:view_user_conf</c=
ode></p>
     <p><span style=3D"color:#c9372c;"><strong><code>resource_type : </code=
></strong><code>data_access</code><strong><code>&nbsp;</code></strong></spa=
n><br><span style=3D"color:#c9372c;"><strong><code>resource_name: </code></=
strong><code>firm_level_access</code></span></p></td>
    <td class=3D"confluenceTd"><br></td>
   </tr>
