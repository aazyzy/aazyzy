    <td class=3D"confluenceTd">44</td>
   </tr>
   <tr>
    <td class=3D"confluenceTd"><strong>ICPMC_FIER</strong></td>
    <td class=3D"confluenceTd">55</td>
    <td class=3D"confluenceTd">47</td>
