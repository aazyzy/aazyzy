<body>
    <h1>Multi-Firm User Discovery - Fiera</h1>
    <div class=3D"Section1">
        <h1 style=3D"text-align: left;" id=3D"MultiFirmUserDiscoveryFiera-B=
usinessStructure"><strong>Business Structure</strong></h1>
<p><img class=3D"drawio-diagram-image" width=3D"468" style=3D"width:575px;m=
ax-width: 100%;" src=3D"4c40b4a70f2e17848eccf4eafe484a3519929c24deee6625b63=
1568de15f570f" height=3D"201"></p>
<h1 style=3D"text-align: left;" id=3D"MultiFirmUserDiscoveryFiera-FirmUsage=
Today">Firm Usage Today</h1>
<div class=3D"table-wrap">
 <table class=3D"relative-table wrapped confluenceTable" style=3D"width: 36=
.5021%;">
  <colgroup>
   <col style=3D"width: 27.1431%;">
   <col style=3D"width: 19.7172%;">
   <col style=3D"width: 19.5935%;">
   <col style=3D"width: 16.4858%;">
   <col style=3D"width: 0.510495%;">
  </colgroup>
  <tbody>
   <tr>
    <th scope=3D"col" class=3D"confluenceTh">Fiera</th>
    <th scope=3D"col" class=3D"confluenceTh">CX</th>
    <th scope=3D"col" class=3D"confluenceTh">R2</th>
    <th scope=3D"col" class=3D"confluenceTh">SZ</th>
    <th scope=3D"col" class=3D"confluenceTh">NetRep</th>
   </tr>
   <tr>
    <td class=3D"confluenceTd"><strong>CGOV</strong></td>
    <td class=3D"confluenceTd">21</td>
    <td class=3D"confluenceTd">19</td>
